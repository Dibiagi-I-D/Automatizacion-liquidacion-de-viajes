# Variables de entorno del servidor

# Puerto del servidor (default: 3000)
PORT=3000

# URL de la base de datos PostgreSQL
# Formato: postgresql://usuario:password@host:puerto/nombre_db
DATABASE_URL="postgresql://postgres:password@localhost:5432/gastos_logistica?schema=public"

# Secret para JWT (CAMBIAR EN PRODUCCIÓN)
JWT_SECRET="secret-super-seguro-cambiar-en-produccion"

# Entorno
NODE_ENV="development"

# Credenciales de service account de Google (Speech-to-Text)
# Local: ruta al archivo .json descargado de Google Cloud
GOOGLE_APPLICATION_CREDENTIALS="./gcp-credentials.json"
# Produccion (Render): el JSON completo en una sola variable
# GOOGLE_CREDENTIALS_JSON='{"type":"service_account", ...}'
